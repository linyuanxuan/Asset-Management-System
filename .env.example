# ============================================================
# 个人数字资产台账 - 环境配置示例
# 使用方法：复制为 .env 后执行 `npm run init` 自动填充密钥与密码哈希
# 注意：.env 已在 .gitignore 中，禁止上传到任何网络位置
# ============================================================

# 监听地址与端口（仅本机访问，不要改成 0.0.0.0 除非你清楚风险）
HOST=127.0.0.1
PORT=3000

# 管理员账号（仅单用户，不需要注册）
ADMIN_USERNAME=admin

# 管理员密码哈希（scrypt 加盐，禁止填明文）
# 由 `npm run init` 自动生成写入，形如：
# scrypt$16384$8$1$<salt_hex>$<hash_hex>
ADMIN_PASSWORD_HASH=

# 敏感字段 AES-256-GCM 加密主密钥：64 位十六进制 = 32 字节
# 由 `npm run init` 自动生成。丢失后已加密数据无法解密，务必单独备份。
AES_KEY=

# 会话签名密钥（>=32 字符）
SESSION_SECRET=

# 会话空闲过期时间（分钟），默认 120
SESSION_TTL_MINUTES=120

# 是否强制 Cookie 走 HTTPS（通过反向代理加 TLS 时设为 1）
COOKIE_SECURE=0

# SQLite 数据库文件路径（相对项目根目录）
DB_PATH=./data/assets.db

# 到期提醒阈值（天），小于等于该天数时条目标红
WARN_DAYS=30
